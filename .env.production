# ============================================================
# DealFlow AI — .env.production
# Generated from audit of src/config/env.ts (Zod schema)
# NEVER commit this file. Use secrets manager in production.
# ============================================================

# ─── App ───────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# ─── PostgreSQL ────────────────────────────────────────
# Used by Docker Compose to configure the postgres container
POSTGRES_DB=dealflow
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# Full DATABASE_URL is overridden by docker-compose.yml using above vars.
# Keep this here as fallback for Prisma CLI (prisma migrate, prisma studio)
DATABASE_URL=postgresql://dealflow:CHANGE_ME_STRONG_PASSWORD_32_CHARS@localhost:5432/dealflow?schema=public

# ─── Redis ─────────────────────────────────────────────
# Password used by redis container command AND by app REDIS_URL
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD
# Full URL is overridden in docker-compose.yml for internal networking.
# Keep here for local CLI use.
REDIS_URL=redis://:CHANGE_ME_REDIS_STRONG_PASSWORD@localhost:6379

# ─── JWT ───────────────────────────────────────────────
# REQUIRED: min 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MINIMUM_32_CHARS_REQUIRED_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Encryption (AES-256-GCM for secrets at rest) ─────
# REQUIRED: exactly 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_EXACTLY_0000000000000000000000000000000000

# ─── Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_WEBHOOK_URL=https://your-domain.com/api/webhooks/twilio/sms

# ─── Anthropic ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxx

# ─── AWS S3 ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=dealflow-documents-prod

# ─── Email / SMTP ──────────────────────────────────────
# Option A: SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxx
# Option B: SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxx
EMAIL_FROM=noreply@your-domain.com

# ─── DocuSign ──────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_SECRET=your_docusign_secret
DOCUSIGN_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Sentry ────────────────────────────────────────────
SENTRY_DSN=https://xxxx@o0000000.ingest.sentry.io/0000000

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com

# ─── BullMQ Dashboard ──────────────────────────────────
BULL_DASHBOARD_USER=admin
# Generate: openssl rand -base64 16
BULL_DASHBOARD_PASS=CHANGE_ME_BULL_DASHBOARD_PASS
