// ============================================================
// DealFlow AI — Prisma Schema v3.0
// PostgreSQL production database
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  ACQUISITION_MANAGER
  DISPOSITION_MANAGER
  VIRTUAL_ASSISTANT
  READ_ONLY
}

enum SellerStatus {
  NEW
  WARM
  NEGOTIATING
  AGREED
  LOST
  COLD
  DO_NOT_CONTACT
}

enum BuyerStatus {
  NEW
  INTERESTED
  NEGOTIATING
  AGREED
  COLD
  DO_NOT_CONTACT
}

enum ContractStatus {
  PENDING
  SENT
  SIGNED
  CANCELLED
  EXPIRED
}

enum AssignmentStatus {
  AVAILABLE
  PITCHED
  NEGOTIATING
  ASSIGNED
  CANCELLED
  CLOSED
}

enum MessageRole {
  AI
  PROSPECT
  OWNER
  SYSTEM
}

enum MessageChannel {
  SMS
  EMAIL
  INTERNAL
}

enum NegotiationSide {
  SELLER
  BUYER
}

enum OfferParty {
  AI
  PROSPECT
}

enum NotificationType {
  SUCCESS
  WARNING
  DANGER
  INFO
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActivityColor {
  GREEN
  AMBER
  RED
  BLUE
  ACCENT
  TEXT3
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  SENT_SMS
  RECEIVED_SMS
  AI_RESPONSE
  PRICE_SET
  NEGOTIATION_STARTED
  OFFER_MADE
  OFFER_RECEIVED
  DEAL_AGREED
  DEAL_LOST
  CONTRACT_SENT
  CONTRACT_SIGNED
  ASSIGNMENT_SENT
  ASSIGNMENT_SIGNED
  OPTED_OUT
  REINSTATED
  AI_PAUSED
  AI_RESUMED
  USER_LOGIN
  USER_LOGOUT
  SETTINGS_CHANGED
  WEBHOOK_RECEIVED
}

enum ConsentStatus {
  PENDING
  CONFIRMED
  OPTED_OUT
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

// ─────────────────────────────────────────────────────────
// CORE ENTITIES
// ─────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("starter")
  logoUrl     String?
  timezone    String   @default("America/New_York")

  // AI Config
  aiPersona   String   @default("Alex")
  msgTone     String   @default("professional")
  maxFollowups Int     @default(5)
  followupDelayHours Int @default(24)

  // Twilio
  twilioSid        String?
  twilioToken      String?  // encrypted at application layer
  twilioFrom       String?

  // Anthropic
  anthropicKey     String?  // encrypted at application layer

  // E-sign
  docusignKey      String?  // encrypted

  // AWS
  s3Bucket         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  campaigns        Campaign[]
  sellerLeads      SellerLead[]
  buyerLeads       BuyerLead[]
  contracts        Contract[]
  assignmentContracts AssignmentContract[]
  notifications    Notification[]
  activities       Activity[]
  tasks            Task[]
  auditLogs        AuditLog[]
  customFields     CustomField[]
  tags             Tag[]
  smsStats         SmsStats?

  @@index([slug])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole  @default(VIRTUAL_ASSISTANT)
  avatarUrl      String?
  phone          String?

  // Auth
  emailVerified  Boolean   @default(false)
  emailVerifyToken String? @unique
  passwordResetToken String? @unique
  passwordResetExpiry DateTime?
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?   // TOTP secret, encrypted
  mfaBackupCodes String[]  // hashed backup codes
  lastLoginAt    DateTime?
  failedLoginAttempts Int  @default(0)
  lockedUntil    DateTime?

  // Refresh tokens managed as separate records
  refreshTokens  RefreshToken[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedSellers SellerLead[] @relation("SellerOwner")
  assignedBuyers  BuyerLead[]  @relation("BuyerOwner")
  tasks          Task[]
  auditLogs      AuditLog[]
  messages       Message[]   @relation("MessageSentBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique  // SHA-256 of the actual token
  expiresAt   DateTime
  userAgent   String?
  ip          String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ─────────────────────────────────────────────────────────
// CAMPAIGNS
// ─────────────────────────────────────────────────────────

model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           String    // "seller" | "buyer"
  description    String?
  aiPersona      String?
  msgTone        String?
  maxFollowups   Int?
  followupDelayHours Int?

  // Stats (denormalized for fast dashboard reads)
  totalLeads     Int       @default(0)
  sentCount      Int       @default(0)
  respondedCount Int       @default(0)
  interestedCount Int      @default(0)
  convertedCount  Int      @default(0)

  isActive       Boolean   @default(true)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerLeads    SellerLead[]
  buyerLeads     BuyerLead[]

  @@index([organizationId])
  @@index([organizationId, type])
}

// ─────────────────────────────────────────────────────────
// SELLER LEADS
// ─────────────────────────────────────────────────────────

model SellerLead {
  id             String       @id @default(cuid())
  organizationId String
  campaignId     String?
  ownerId        String?      // assigned user

  // Contact
  name           String
  phone          String       // normalized E.164
  email          String?
  address        String?
  city           String?
  state          String?
  zip            String?

  // Status & Scoring
  status         SellerStatus @default(NEW)
  score          Int          @default(50)
  motivationScore Int?        // AI-generated 0-100
  probabilityScore Float?     // 0-1, contract probability

  // AI Control
  aiPaused       Boolean      @default(false)
  negotiationActive Boolean   @default(false)

  // Negotiation Config (set by human manager)
  priceMin       Int?
  priceMax       Int?
  priceLowball   Int?
  priceNotes     String?
  lastAiOffer    Int?
  agreedPrice    Int?
  agreedAt       DateTime?

  // Tracking
  followupCount  Int          @default(0)
  contractSent   Boolean      @default(false)
  contractSentAt DateTime?
  removedAt      DateTime?
  reinstatedAt   DateTime?

  // Consent / Compliance
  consentStatus  ConsentStatus @default(PENDING)
  consentMethod  String?       // "sms_keyword", "import", "web_form"
  consentAt      DateTime?
  optedOutAt     DateTime?
  optedOutMethod String?

  // Source
  source         String?
  leadScore      Int          @default(0)
  customFields   Json?        @default("{}")
  tags           TagOnSeller[]

  // Metadata
  importedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner          User?        @relation("SellerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages       Message[]
  negotiation    Negotiation?
  contract       Contract?
  followUps      FollowUp[]
  auditLogs      AuditLog[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, campaignId])
  @@index([phone])
}

// ─────────────────────────────────────────────────────────
// BUYER LEADS
// ─────────────────────────────────────────────────────────

model BuyerLead {
  id             String      @id @default(cuid())
  organizationId String
  campaignId     String?
  ownerId        String?

  // Contact
  name           String
  phone          String      // normalized E.164
  email          String?

  // Buyer Profile
  interest       String?     // "single_family", "multi_family", "land", etc.
  targetMarkets  String[]
  maxPurchasePrice Int?
  buyingCriteria String?

  // Status & Scoring
  status         BuyerStatus @default(NEW)
  score          Int         @default(50)
  qualificationScore Float?  // AI-generated probability 0-1

  // AI Control
  aiPaused       Boolean     @default(false)
  negotiationActive Boolean  @default(false)

  // Negotiation Config (set by manager per deal)
  assignmentContractId String?
  feeMin         Int         @default(5000)
  feeMax         Int         @default(15000)
  lastAiOffer    Int?
  agreedFee      Int?
  agreedAt       DateTime?

  // Tracking
  followupCount  Int         @default(0)
  contractSent   Boolean     @default(false)
  contractSentAt DateTime?

  // Consent / Compliance
  consentStatus  ConsentStatus @default(PENDING)
  consentMethod  String?
  consentAt      DateTime?
  optedOutAt     DateTime?
  optedOutMethod String?

  // Source
  source         String?
  customFields   Json?       @default("{}")
  tags           TagOnBuyer[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner          User?       @relation("BuyerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages       Message[]
  negotiation    Negotiation?
  assignmentContracts AssignmentContract[]
  followUps      FollowUp[]
  auditLogs      AuditLog[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([phone])
}

// ─────────────────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────────────────

model Message {
  id             String        @id @default(cuid())
  organizationId String
  sellerId       String?
  buyerId        String?
  sentById       String?       // null = AI-generated

  role           MessageRole
  channel        MessageChannel @default(SMS)
  content        String
  twilioSid      String?       @unique  // deduplication key
  smsStatus      String?       // "queued" | "sent" | "delivered" | "failed" | "undelivered" | "demo"
  errorCode      String?
  errorMessage   String?
  retryCount     Int           @default(0)

  // AI Metadata
  isAiGenerated  Boolean       @default(false)
  promptTokens   Int?
  completionTokens Int?
  modelUsed      String?

  // TCPA compliance
  isOptOutMessage Boolean      @default(false)

  createdAt      DateTime      @default(now())

  seller         SellerLead?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  buyer          BuyerLead?    @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  sentBy         User?         @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([buyerId])
  @@index([organizationId])
  @@index([twilioSid])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────
// NEGOTIATIONS
// ─────────────────────────────────────────────────────────

model Negotiation {
  id             String          @id @default(cuid())
  organizationId String
  sellerId       String?         @unique
  buyerId        String?         @unique
  side           NegotiationSide

  // Bounds
  floorPrice     Int             // for seller: min we pay; for buyer: min fee we accept
  ceilPrice      Int             // for seller: max we pay; for buyer: max fee we ask
  openingOffer   Int             // first offer

  // Current state
  currentOffer   Int?
  agreedAmount   Int?
  agreedAt       DateTime?
  status         String          @default("active") // "active" | "agreed" | "lost" | "paused"

  // Limits
  maxConcessions Int             @default(3)
  concessionsMade Int            @default(0)

  notes          String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  seller         SellerLead?     @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  buyer          BuyerLead?      @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  offers         NegotiationOffer[]

  @@index([organizationId])
}

model NegotiationOffer {
  id             String      @id @default(cuid())
  negotiationId  String
  party          OfferParty
  amount         Int
  message        String?
  isCounterOffer Boolean     @default(false)
  createdAt      DateTime    @default(now())

  negotiation    Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
}

// ─────────────────────────────────────────────────────────
// CONTRACTS
// ─────────────────────────────────────────────────────────

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  sellerId       String?        @unique
  version        Int            @default(1)

  address        String
  sellerName     String
  purchasePrice  Int
  closingDate    DateTime?
  earnestMoney   Int?

  status         ContractStatus @default(PENDING)

  // Document management
  pdfKey         String?        // S3 key
  pdfUrl         String?        // presigned or CDN URL
  docusignEnvelopeId String?
  signedAt       DateTime?
  signedPdfKey   String?

  // Assignment fee range derived from this contract
  defaultFeeMin  Int?
  defaultFeeMax  Int?

  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seller         SellerLead?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  assignments    AssignmentContract[]
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model AssignmentContract {
  id             String           @id @default(cuid())
  organizationId String
  contractId     String
  buyerId        String?
  version        Int              @default(1)

  assignmentFee  Int
  status         AssignmentStatus @default(AVAILABLE)

  // Document management
  pdfKey         String?
  pdfUrl         String?
  docusignEnvelopeId String?
  signedAt       DateTime?
  signedPdfKey   String?

  closingDate    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract       Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  buyer          BuyerLead?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([contractId])
  @@index([organizationId, status])
}

// ─────────────────────────────────────────────────────────
// FOLLOW-UPS
// ─────────────────────────────────────────────────────────

model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  sellerId       String?
  buyerId        String?
  sequenceNumber Int
  content        String
  scheduledFor   DateTime
  status         FollowUpStatus @default(SCHEDULED)
  sentAt         DateTime?
  failedAt       DateTime?
  failReason     String?
  bullJobId      String?        // BullMQ job ID for cancellation
  createdAt      DateTime       @default(now())

  seller         SellerLead?    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyer          BuyerLead?     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([scheduledFor, status])
  @@index([sellerId])
  @@index([buyerId])
}

// ─────────────────────────────────────────────────────────
// CRM: TASKS, NOTES
// ─────────────────────────────────────────────────────────

model Task {
  id             String      @id @default(cuid())
  organizationId String
  assignedToId   String?
  sellerId       String?
  buyerId        String?
  title          String
  description    String?
  dueAt          DateTime?
  status         TaskStatus  @default(OPEN)
  priority       Int         @default(2)  // 1=low, 2=medium, 3=high, 4=urgent
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, status])
  @@index([dueAt, status])
}

// ─────────────────────────────────────────────────────────
// NOTIFICATIONS & ACTIVITY
// ─────────────────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  type           NotificationType @default(INFO)
  title          String
  body           String
  actionLabel    String?
  actionData     Json?
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, dismissedAt])
}

model Activity {
  id             String        @id @default(cuid())
  organizationId String
  text           String
  color          ActivityColor @default(BLUE)
  entityType     String?       // "seller" | "buyer" | "contract" etc.
  entityId       String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String      // "seller_lead" | "buyer_lead" | "contract" etc.
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  meta           Json?
  createdAt      DateTime    @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  seller         SellerLead?   @relation(fields: [entityId], references: [id], onDelete: NoAction, map: "audit_seller_fk")
  buyer          BuyerLead?    @relation(fields: [entityId], references: [id], onDelete: NoAction, map: "audit_buyer_fk")
  contract       Contract?     @relation(fields: [entityId], references: [id], onDelete: NoAction, map: "audit_contract_fk")
  assignment     AssignmentContract? @relation(fields: [entityId], references: [id], onDelete: NoAction, map: "audit_assignment_fk")

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────
// TAGS & CUSTOM FIELDS
// ─────────────────────────────────────────────────────────

model Tag {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  color          String        @default("#6c63ff")
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellers        TagOnSeller[]
  buyers         TagOnBuyer[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TagOnSeller {
  sellerId       String
  tagId          String
  createdAt      DateTime    @default(now())

  seller         SellerLead  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  tag            Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sellerId, tagId])
}

model TagOnBuyer {
  buyerId        String
  tagId          String
  createdAt      DateTime    @default(now())

  buyer          BuyerLead   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  tag            Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([buyerId, tagId])
}

model CustomField {
  id             String       @id @default(cuid())
  organizationId String
  entityType     String       // "seller" | "buyer"
  fieldKey       String
  fieldLabel     String
  fieldType      String       @default("text") // "text" | "number" | "date" | "boolean" | "select"
  options        String[]
  required       Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId, entityType])
}

// ─────────────────────────────────────────────────────────
// SMS STATS
// ─────────────────────────────────────────────────────────

model SmsStats {
  id             String       @id @default(cuid())
  organizationId String       @unique
  sent           Int          @default(0)
  received       Int          @default(0)
  failed         Int          @default(0)
  delivered      Int          @default(0)
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
